{
  "description": "codex-auto-startstop: hand off before the 5h limit, resume after the reset",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex_auto_startstop.py\" stop",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\codex_auto_startstop.py\" stop",
            "timeout": 60,
            "statusMessage": "codex-auto-startstop: check usage and prepare a handoff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex_auto_startstop.py\" session-start",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\codex_auto_startstop.py\" session-start",
            "timeout": 60,
            "statusMessage": "codex-auto-startstop: re-arm a pending continuation"
          }
        ]
      }
    ]
  }
}
